node_modules/
dist/
out/
.DS_Store
*.log
.env*

# Sprite art is not published. The cat's old art folders (the cat was removed
# 2026-11-11) stay ignored in case they are still on disk.
assets/walk/
assets/walk_nobag/
assets/loaf/
assets/sleep/
assets/pile/
assets/fx/
assets/preview/
# The cherub (the user's own art, cut from a Perchance image): same rule, art stays local.
# Only its manifest is tracked.
assets/cherub/*
!assets/cherub/manifest.json
# The app icon is drawn from his art (scripts/icon.mjs), so it stays local too.
build/icon.png
build/icon.icns
build/background.png
